{
  "openapi": "3.1.0",
  "info": {
    "title": "Transactions",
    "version": "1.0.0",
    "description": "Operations published by Extole Transactions components. Generated from the component contracts on my.extole.com."
  },
  "servers": [
    {
      "description": "Production",
      "url": "https://events.extole.io"
    }
  ],
  "paths": {
    "/v6/events/template_transacted_business_event": {
      "post": {
        "operationId": "create_event",
        "summary": "Create New",
        "description": "Submits a completed transaction from your backend so it can be attributed, counted toward quality, and rewarded.",
        "x-extole-type": "SERVER_TO_EXTOLE",
        "tags": [
          "ACTION"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "partner_conversion_id"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Email address of the person the event belongs to."
                  },
                  "partner_user_id": {
                    "type": "string",
                    "description": "Your own identifier for the person, when you have one."
                  },
                  "partner_conversion_id": {
                    "type": "string",
                    "description": "Your own order or transaction identifier. Used to de-duplicate repeat submissions."
                  },
                  "cart_value": {
                    "type": "string",
                    "description": "Transaction value, as a decimal string in the currency below."
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$",
                    "description": "ISO 4217 currency code of the transaction value."
                  },
                  "coupon_code": {
                    "type": "string",
                    "description": "Coupon redeemed on the transaction, when one was."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "event_id",
                    "person_id"
                  ],
                  "properties": {
                    "event_id": {
                      "type": "string",
                      "description": "Unique identifier for the submitted event."
                    },
                    "person_id": {
                      "type": "string",
                      "description": "Extole person the event resolved to."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "binding_error": {
                    "$ref": "#/components/examples/binding_error"
                  },
                  "invalid_json": {
                    "$ref": "#/components/examples/invalid_json"
                  },
                  "invalid_parameter": {
                    "$ref": "#/components/examples/invalid_parameter"
                  },
                  "missing_request_body": {
                    "$ref": "#/components/examples/missing_request_body"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "access_denied": {
                    "$ref": "#/components/examples/access_denied"
                  },
                  "method_unauthorized": {
                    "$ref": "#/components/examples/method_unauthorized"
                  },
                  "missing_access_token": {
                    "$ref": "#/components/examples/missing_access_token"
                  }
                }
              }
            }
          }
        },
        "servers": [
          {
            "description": "Production",
            "url": "https://events.extole.io"
          }
        ],
        "x-extole-component": "template_transacted_business_event"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "HEADER": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "A client access token, issued to your Extole account and used from your own backend. Not a consumer access token - a consumer token identifies one person and cannot call this operation.",
        "x-bearer-format": "bearer"
      },
      "QUERY": {
        "type": "apiKey",
        "in": "query",
        "name": "access_token",
        "description": "A client access token, issued to your Extole account and used from your own backend. Not a consumer access token - a consumer token identifies one person and cannot call this operation."
      }
    },
    "schemas": {
      "RestExceptionResponse": {
        "type": "object",
        "description": "Represents the API error response",
        "properties": {
          "code": {
            "type": "string",
            "description": "Specific error code for this error type, documented per endpoint"
          },
          "http_status_code": {
            "type": "integer",
            "description": "HTTP status code that was returned with this error, useful if client get response code"
          },
          "message": {
            "type": "string",
            "description": "User readable English description of the error"
          },
          "parameters": {
            "type": "object",
            "description": "Attributes related to the error, varies be error code, documented per endpoint",
            "additionalProperties": {
              "type": "object",
              "description": "Attributes related to the error, varies be error code, documented per endpoint"
            }
          },
          "unique_id": {
            "type": "string",
            "description": "Unique id associated with this error, useful for discussions with Extole"
          }
        },
        "required": [
          "code",
          "http_status_code",
          "message",
          "parameters",
          "unique_id"
        ]
      }
    },
