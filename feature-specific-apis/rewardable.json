{
  "openapi": "3.1.0",
  "info": {
    "title": "Rewardable",
    "version": "1.0.0",
    "description": "Operations published by Extole Rewardable components. Generated from the component contracts on my.extole.com."
  },
  "servers": [
    {
      "description": "Production - your program domain",
      "url": "https://{brand}.extole.io",
      "variables": {
        "brand": {
          "default": "yourcompany",
          "description": "Your Extole client subdomain (e.g. 'mycompany' for mycompany.extole.io)"
        }
      }
    },
    {
      "description": "Production - Extole events host",
      "url": "https://events.extole.io"
    }
  ],
  "paths": {
    "/v4/me/rewards": {
      "get": {
        "operationId": "get_rewards",
        "summary": "Current Status and History",
        "description": "Returns every reward this person has earned, each with the state it is in now and the dates it moved through: earned, issued, delivered, redeemed, and when it expires. Called from the browser or app with that person's own access token, so a person only ever reads their own rewards.",
        "x-extole-type": "CONSUMER_TO_EXTOLE",
        "tags": [
          "VIEW"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "description": "Every reward belonging to the person the access token identifies.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "reward_id": {
                        "type": "string",
                        "description": "Extole identifier for this reward."
                      },
                      "reward_name": {
                        "type": "string",
                        "description": "Configured name of the reward that was earned."
                      },
                      "state": {
                        "type": "string",
                        "description": "Where the reward has reached: earned, issued, delivered, redeemed, expired or failed."
                      },
                      "face_value": {
                        "type": "string",
                        "description": "Value of the reward as the person sees it."
                      },
                      "face_value_type": {
                        "type": "string",
                        "description": "What that value is denominated in."
                      },
                      "date_earned": {
                        "type": "string",
                        "description": "When the person qualified for the reward."
                      },
                      "date_issued": {
                        "type": "string",
                        "description": "When the reward was issued, if it has been."
                      },
                      "date_delivered": {
                        "type": "string",
                        "description": "When the reward reached the person, if it has."
                      },
                      "redeemed_date": {
                        "type": "string",
                        "description": "When the person redeemed it, if they have."
                      },
                      "expiry_date": {
                        "type": "string",
                        "description": "When the reward stops being redeemable."
                      },
                      "campaign_id": {
                        "type": "string",
                        "description": "Campaign the reward was earned in."
                      },
                      "journey_name": {
                        "type": "string",
                        "description": "Journey the person was on when they earned it."
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "binding_error": {
                    "$ref": "#/components/examples/binding_error"
                  },
                  "invalid_json": {
                    "$ref": "#/components/examples/invalid_json"
                  },
                  "invalid_parameter": {
                    "$ref": "#/components/examples/invalid_parameter"
                  },
                  "missing_request_body": {
                    "$ref": "#/components/examples/missing_request_body"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "access_denied": {
                    "$ref": "#/components/examples/access_denied"
                  },
                  "expired_access_token": {
                    "$ref": "#/components/examples/expired_access_token"
                  },
                  "invalid_access_token": {
                    "$ref": "#/components/examples/invalid_access_token"
                  },
                  "jwt_authentication_error": {
                    "$ref": "#/components/examples/jwt_authentication_error"
                  },
                  "method_unauthorized": {
                    "$ref": "#/components/examples/method_unauthorized"
                  },
                  "missing_access_token": {
                    "$ref": "#/components/examples/missing_access_token"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v6/events/advocate_manual_approve": {
      "post": {
        "operationId": "force_approve",
        "summary": "Force Approve",
        "description": "Approves a rewardable that is being held for review, by submitting this reward's own approve event. The campaign's rules issue the reward once the event is accepted, so a successful call means the approval was recorded, not that the reward has reached the person.",
        "x-extole-type": "SERVER_TO_EXTOLE",
        "tags": [
          "ACTION"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "person_id",
                  "target"
                ],
                "properties": {
                  "person_id": {
                    "type": "string",
                    "description": "Extole person whose rewardable is being approved."
                  },
                  "target": {
                    "type": "string",
                    "description": "Which campaign the approval applies to, written as campaign_id: followed by the campaign's id."
                  },
                  "journey.campaign_id": {
                    "type": "string",
                    "description": "Campaign of the journey the rewardable belongs to."
                  },
                  "container": {
                    "type": "string",
                    "description": "Container the rewardable sits in, when it has one."
                  },
                  "note": {
                    "type": "string",
                    "description": "Why the approval was made. Recorded alongside it."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "event_id"
                  ],
                  "properties": {
                    "event_id": {
                      "type": "string",
                      "description": "Identifier of the event. The outcome follows from the campaign's rules, so read the person's rewards to confirm it."
                    },
                    "person_id": {
                      "type": "string",
                      "description": "Extole person the event resolved to."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "binding_error": {
                    "$ref": "#/components/examples/binding_error"
                  },
                  "invalid_json": {
                    "$ref": "#/components/examples/invalid_json"
                  },
                  "invalid_parameter": {
                    "$ref": "#/components/examples/invalid_parameter"
                  },
                  "missing_request_body": {
                    "$ref": "#/components/examples/missing_request_body"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "access_denied": {
                    "$ref": "#/components/examples/access_denied"
                  },
                  "expired_access_token": {
                    "$ref": "#/components/examples/expired_access_token"
                  },
                  "invalid_access_token": {
                    "$ref": "#/components/examples/invalid_access_token"
                  },
                  "jwt_authentication_error": {
                    "$ref": "#/components/examples/jwt_authentication_error"
                  },
                  "method_unauthorized": {
                    "$ref": "#/components/examples/method_unauthorized"
                  },
                  "missing_access_token": {
                    "$ref": "#/components/examples/missing_access_token"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v6/events/advocate_manual_request": {
      "post": {
        "operationId": "create_reward",
        "summary": "Create New",
        "description": "Issues this reward to a person who did not reach it through the normal flow, by submitting the reward's manual request event. The campaign's rules still decide the outcome, so a successful call means the request was recorded.",
        "x-extole-type": "SERVER_TO_EXTOLE",
        "tags": [
          "ACTION"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "person_id",
                  "target"
                ],
                "properties": {
                  "person_id": {
                    "type": "string",
                    "description": "Extole person to reward."
                  },
                  "target": {
                    "type": "string",
                    "description": "Which campaign issues the reward, written as campaign_id: followed by the campaign's id."
                  },
                  "journey.campaign_id": {
                    "type": "string",
                    "description": "Campaign of the journey the rewardable belongs to."
                  },
                  "note": {
                    "type": "string",
                    "description": "Why the reward is being issued by hand. Recorded alongside it."
                  },
                  "other_person_id": {
                    "type": "string",
                    "description": "The other person in the referral relationship, when the reward depends on one."
                  },
                  "ignore_quality": {
                    "type": "boolean",
                    "description": "Issue the reward even when the quality rules would hold it."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "event_id"
                  ],
                  "properties": {
                    "event_id": {
                      "type": "string",
                      "description": "Identifier of the event. The outcome follows from the campaign's rules, so read the person's rewards to confirm it."
                    },
                    "person_id": {
                      "type": "string",
                      "description": "Extole person the event resolved to."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "binding_error": {
                    "$ref": "#/components/examples/binding_error"
                  },
                  "invalid_json": {
                    "$ref": "#/components/examples/invalid_json"
                  },
                  "invalid_parameter": {
                    "$ref": "#/components/examples/invalid_parameter"
                  },
                  "missing_request_body": {
                    "$ref": "#/components/examples/missing_request_body"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "access_denied": {
                    "$ref": "#/components/examples/access_denied"
                  },
                  "expired_access_token": {
                    "$ref": "#/components/examples/expired_access_token"
                  },
                  "invalid_access_token": {
                    "$ref": "#/components/examples/invalid_access_token"
                  },
                  "jwt_authentication_error": {
                    "$ref": "#/components/examples/jwt_authentication_error"
                  },
                  "method_unauthorized": {
                    "$ref": "#/components/examples/method_unauthorized"
                  },
                  "missing_access_token": {
                    "$ref": "#/components/examples/missing_access_token"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "HEADER": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "A client access token, issued to your Extole account and used from your own backend. Never send a client token from a consumer device.",
        "x-bearer-format": "bearer"
      },
      "QUERY_PARAM": {
        "type": "apiKey",
        "in": "query",
        "name": "access_token",
        "description": "A client access token, issued to your Extole account and used from your own backend. Never send a client token from a consumer device."
      },
      "COOKIE": {
        "type": "apiKey",
        "in": "cookie",
        "name": "extole_token",
        "description": "A consumer access token, issued to a single person in the browser or app. Not a client access token - never send a client token from a consumer device."
      }
    },
    "schemas": {
      "RestExceptionResponse": {
        "type": "object",
        "description": "Represents the API error response",
        "properties": {
          "code": {
            "type": "string",
            "description": "Specific error code for this error type, documented per endpoint"
          },
          "http_status_code": {
            "type": "integer",
            "description": "HTTP status code that was returned with this error, useful if client get response code"
          },
          "message": {
            "type": "string",
            "description": "User readable English description of the error"
          },
          "parameters": {
            "type": "object",
            "description": "Attributes related to the error, varies be error code, documented per endpoint",
            "additionalProperties": {
              "type": "object",
              "description": "Attributes related to the error, varies be error code, documented per endpoint"
            }
          },
          "unique_id": {
            "type": "string",
            "description": "Unique id associated with this error, useful for discussions with Extole"
          }
        },
        "required": [
          "code",
          "http_status_code",
          "message",
          "parameters",
          "unique_id"
        ]
      }
    },
    "examples": {
      "binding_error": {
        "summary": "binding_error",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 400,
          "code": "binding_error",
          "message": "Argument is not of the expected type",
          "parameters": {}
        }
      },
      "invalid_json": {
        "summary": "invalid_json",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 400,
          "code": "invalid_json",
          "message": "JSON is invalid",
          "parameters": {}
        }
      },
      "invalid_parameter": {
        "summary": "invalid_parameter",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 400,
          "code": "invalid_parameter",
          "message": "Parameter is invalid.",
          "parameters": {}
        }
      },
      "missing_request_body": {
        "summary": "missing_request_body",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 400,
          "code": "missing_request_body",
          "message": "Missing request body",
          "parameters": {}
        }
      },
      "access_denied": {
        "summary": "access_denied",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 403,
          "code": "access_denied",
          "message": "The access_token provided is not permitted to access the specified resource.",
          "parameters": {}
        }
      },
      "method_unauthorized": {
        "summary": "method_unauthorized",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 403,
          "code": "method_unauthorized",
          "message": "Access forbidden to this endpoint",
          "parameters": {}
        }
      },
      "missing_access_token": {
        "summary": "missing_access_token",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 403,
          "code": "missing_access_token",
          "message": "No access_token was provided with this request.",
          "parameters": {}
        }
      },
      "expired_access_token": {
        "summary": "expired_access_token",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 403,
          "code": "expired_access_token",
          "message": "The access_token provided with this request has expired.",
          "parameters": {}
        }
      },
      "invalid_access_token": {
        "summary": "invalid_access_token",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 403,
          "code": "invalid_access_token",
          "message": "The access_token provided with this request is invalid.",
          "parameters": {}
        }
      },
      "jwt_authentication_error": {
        "summary": "jwt_authentication_error",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 403,
          "code": "jwt_authentication_error",
          "message": "The jwt authentication failed.",
          "parameters": {}
        }
      }
    }
  }
}
