{
  "openapi": "3.1.0",
  "info": {
    "title": "Rewardable",
    "version": "1.0.0",
    "description": "Operations published by Extole Rewardable components. Generated from the component contracts on my.extole.com."
  },
  "servers": [
    {
      "description": "Production - Extole events host",
      "url": "https://events.extole.io"
    }
  ],
  "paths": {
    "/v6/events/{approve_event_name}": {
      "post": {
        "operationId": "force_approve",
        "summary": "Force Approve",
        "description": "Approves a rewardable that is being held for review, by submitting this reward's own approve event. The campaign's rules issue the reward once the event is accepted, so a successful call means the approval was recorded, not that the reward has reached the person.",
        "x-extole-type": "SERVER_TO_EXTOLE",
        "tags": [
          "ACTION"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "person_id",
                  "target"
                ],
                "properties": {
                  "person_id": {
                    "type": "string",
                    "description": "Extole person whose rewardable is being approved."
                  },
                  "target": {
                    "type": "string",
                    "description": "Which campaign the approval applies to, written as campaign_id: followed by the campaign's id."
                  },
                  "journey.campaign_id": {
                    "type": "string",
                    "description": "Campaign of the journey the rewardable belongs to."
                  },
                  "container": {
                    "type": "string",
                    "description": "Container the rewardable sits in, when it has one."
                  },
                  "note": {
                    "type": "string",
                    "description": "Why the approval was made. Recorded alongside it."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "event_id"
                  ],
                  "properties": {
                    "event_id": {
                      "type": "string",
                      "description": "Identifier of the event. The outcome follows from the campaign's rules, so read the person's rewards to confirm it."
                    },
                    "person_id": {
                      "type": "string",
                      "description": "Extole person the event resolved to."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "binding_error": {
                    "$ref": "#/components/examples/binding_error"
                  },
                  "invalid_json": {
                    "$ref": "#/components/examples/invalid_json"
                  },
                  "invalid_parameter": {
                    "$ref": "#/components/examples/invalid_parameter"
                  },
                  "missing_request_body": {
                    "$ref": "#/components/examples/missing_request_body"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "access_denied": {
                    "$ref": "#/components/examples/access_denied"
                  },
                  "expired_access_token": {
                    "$ref": "#/components/examples/expired_access_token"
                  },
                  "invalid_access_token": {
                    "$ref": "#/components/examples/invalid_access_token"
                  },
                  "jwt_authentication_error": {
                    "$ref": "#/components/examples/jwt_authentication_error"
                  },
                  "method_unauthorized": {
                    "$ref": "#/components/examples/method_unauthorized"
                  },
                  "missing_access_token": {
                    "$ref": "#/components/examples/missing_access_token"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "approve_event_name",
            "in": "path",
            "required": true,
            "description": "The event that approves a rewardable that is waiting on review. It is named after the journey, which here is reward_core, so the event is reward_core_manual_approve. Rename the journey and this name changes with it, so take it from the approveEventName setting on the reward rather than assembling it yourself.",
            "schema": {
              "type": "string",
              "enum": [
                "reward_core_manual_approve"
              ]
            }
          }
        ]
      }
    },
    "/v6/events/{manual_request_event_name}": {
      "post": {
        "operationId": "create_reward",
        "summary": "Create New",
        "description": "Issues this reward to a person who did not reach it through the normal flow, by submitting the reward's manual request event. The campaign's rules still decide the outcome, so a successful call means the request was recorded.",
        "x-extole-type": "SERVER_TO_EXTOLE",
        "tags": [
          "ACTION"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "person_id",
                  "target"
                ],
                "properties": {
                  "person_id": {
                    "type": "string",
                    "description": "Extole person to reward."
                  },
                  "target": {
                    "type": "string",
                    "description": "Which campaign issues the reward, written as campaign_id: followed by the campaign's id."
                  },
                  "journey.campaign_id": {
                    "type": "string",
                    "description": "Campaign of the journey the rewardable belongs to."
                  },
                  "note": {
                    "type": "string",
                    "description": "Why the reward is being issued by hand. Recorded alongside it."
                  },
                  "other_person_id": {
                    "type": "string",
                    "description": "The other person in the referral relationship, when the reward depends on one."
                  },
                  "ignore_quality": {
                    "type": "boolean",
                    "description": "Issue the reward even when the quality rules would hold it."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "event_id"
                  ],
                  "properties": {
                    "event_id": {
                      "type": "string",
                      "description": "Identifier of the event. The outcome follows from the campaign's rules, so read the person's rewards to confirm it."
                    },
                    "person_id": {
                      "type": "string",
                      "description": "Extole person the event resolved to."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "binding_error": {
                    "$ref": "#/components/examples/binding_error"
                  },
                  "invalid_json": {
                    "$ref": "#/components/examples/invalid_json"
                  },
                  "invalid_parameter": {
                    "$ref": "#/components/examples/invalid_parameter"
                  },
                  "missing_request_body": {
                    "$ref": "#/components/examples/missing_request_body"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "access_denied": {
                    "$ref": "#/components/examples/access_denied"
                  },
                  "expired_access_token": {
                    "$ref": "#/components/examples/expired_access_token"
                  },
                  "invalid_access_token": {
                    "$ref": "#/components/examples/invalid_access_token"
                  },
                  "jwt_authentication_error": {
                    "$ref": "#/components/examples/jwt_authentication_error"
                  },
                  "method_unauthorized": {
                    "$ref": "#/components/examples/method_unauthorized"
                  },
                  "missing_access_token": {
                    "$ref": "#/components/examples/missing_access_token"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "manual_request_event_name",
            "in": "path",
            "required": true,
            "description": "The event that asks for this reward to be issued by hand. It is named after the journey, which here is reward_core, so the event is reward_core_manual_request. Rename the journey and this name changes with it, so take it from the manualRequestEventName setting on the reward rather than assembling it yourself.",
            "schema": {
              "type": "string",
              "enum": [
                "reward_core_manual_request"
              ]
            }
          }
        ]
      }
    },
