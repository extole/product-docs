    "/zones/embedded_experience": {
      "get": {
        "operationId": "render",
        "summary": "Render",
        "description": "Renders this experience for the person making the request, in the zone it is installed into. Returns what is live, with no targeting data sent.",
        "x-extole-type": "CONSUMER_TO_EXTOLE",
        "tags": [
          "VIEW"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "description": "Rendered zone content. The shape follows the zone's creative configuration: HTML, JavaScript, JSON, or plain text."
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
