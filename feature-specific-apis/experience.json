  "paths": {
    "/v5/zones/embedded_experience": {
      "get": {
        "operationId": "preview",
        "summary": "Preview Draft",
        "description": "Previews this experience as the campaign's unpublished draft, before it is live. Rendered through the client zone API with the campaign preview sandbox, so it needs a client access token rather than a consumer one.",
        "x-extole-type": "SERVER_TO_EXTOLE",
        "tags": [
          "VIEW"
        ],
        "parameters": [
          {
            "name": "sandbox",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "const": "CAMPAIGN_PREVIEW-7686169356351895310"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "description": "The preview page, which renders the draft of the zone in the campaign preview sandbox."
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "binding_error": {
                    "$ref": "#/components/examples/binding_error"
                  },
                  "invalid_json": {
                    "$ref": "#/components/examples/invalid_json"
                  },
