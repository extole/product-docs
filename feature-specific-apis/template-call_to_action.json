{
  "openapi": "3.1.0",
  "info": {
    "title": "Call To Action",
    "version": "1.0.0",
    "description": "The template every onsite call-to-action placement is cloned from - 7 in the v10 library, including `global_header`, `product_page` and `mobile_menu`. Put the installed placement's name in the path.\n\n**Preview for the ENG-30863 design review, not a merge candidate.**"
  },
  "servers": [
    {
      "description": "Production",
      "url": "https://{program_domain}",
      "variables": {
        "program_domain": {
          "default": "refer.example.com",
          "description": "Your program domain, as shown in My Extole."
        }
      }
    }
  ],
  "paths": {
    "/zones/{zone_name}": {
      "post": {
        "operationId": "render",
        "summary": "Render",
        "description": "The template every onsite call-to-action placement is cloned from - 7 in the v10 library, including `global_header`, `product_page` and `mobile_menu`. Put the installed placement's name in the path.",
        "x-extole-type": "CONSUMER_TO_EXTOLE",
        "tags": [
          "Call To Action"
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": {
                  "type": "object"
                },
                "description": "Targeting and input data passed to the creative."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rendered content. The body shape is set by the component's creative - HTML, JavaScript, JSON or plain text.",
            "content": {
              "*/*": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "binding_error": {
                    "$ref": "#/components/examples/binding_error"
                  },
                  "invalid_json": {
                    "$ref": "#/components/examples/invalid_json"
                  },
                  "invalid_parameter": {
                    "$ref": "#/components/examples/invalid_parameter"
                  },
                  "missing_request_body": {
                    "$ref": "#/components/examples/missing_request_body"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "access_denied": {
                    "$ref": "#/components/examples/access_denied"
                  },
                  "method_unauthorized": {
                    "$ref": "#/components/examples/method_unauthorized"
                  },
                  "missing_access_token": {
                    "$ref": "#/components/examples/missing_access_token"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RestExceptionResponse": {
        "type": "object",
        "description": "Represents the API error response",
        "properties": {
          "code": {
            "type": "string",
            "description": "Specific error code for this error type, documented per endpoint"
          },
          "http_status_code": {
            "type": "integer",
            "description": "HTTP status code that was returned with this error, useful if client get response code"
          },
          "message": {
            "type": "string",
            "description": "User readable English description of the error"
          },
          "parameters": {
            "type": "object",
            "description": "Attributes related to the error, varies be error code, documented per endpoint",
            "additionalProperties": {
              "type": "object",
              "description": "Attributes related to the error, varies be error code, documented per endpoint"
            }
          },
          "unique_id": {
            "type": "string",
            "description": "Unique id associated with this error, useful for discussions with Extole"
          }
        },
        "required": [
          "code",
          "http_status_code",
          "message",
          "parameters",
          "unique_id"
        ]
      }
    },
    "examples": {
