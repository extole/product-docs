{
  "openapi": "3.1.0",
  "info": {
    "title": "Reward Bank",
    "version": "1.0.0",
    "description": "Operations published by Extole Reward Bank components. Generated from the component contracts on my.extole.com."
  },
  "servers": [
    {
      "description": "Production - your program domain",
      "url": "https://{brand}.extole.io",
      "variables": {
        "brand": {
          "default": "yourcompany",
          "description": "Your Extole client subdomain (e.g. 'mycompany' for mycompany.extole.io)"
        }
      }
    }
  ],
  "paths": {
    "/api/v6/zones/bankable_rewards": {
      "post": {
        "operationId": "get_bankable_rewards",
        "summary": "Current Balance and Transaction History",
        "description": "Returns what this person can redeem and what they have redeemed already: the rewards their balance currently reaches, the suppliers those come from, and the redemption history. Rendered for the person the access token identifies, so a person only ever sees their own bank.",
        "x-extole-type": "CONSUMER_TO_EXTOLE",
        "tags": [
          "VIEW"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Optional data merged into the zone's rendering context. Send an empty object when there is nothing to add."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "The person's reward bank as the redemption center reads it.",
                  "properties": {
                    "eligible_rewards": {
                      "type": "array",
                      "description": "Rewards this person's balance currently reaches, each redeemable on its own."
                    },
                    "redemption_suppliers": {
                      "type": "array",
                      "description": "Suppliers the eligible rewards come from."
                    },
                    "redemption_history": {
                      "type": "array",
                      "description": "Redemptions this person has already made. Poll this after redeeming to see a new entry appear."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "binding_error": {
                    "$ref": "#/components/examples/binding_error"
                  },
                  "invalid_json": {
                    "$ref": "#/components/examples/invalid_json"
                  },
                  "invalid_parameter": {
                    "$ref": "#/components/examples/invalid_parameter"
                  },
                  "missing_request_body": {
                    "$ref": "#/components/examples/missing_request_body"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "access_denied": {
                    "$ref": "#/components/examples/access_denied"
                  },
                  "expired_access_token": {
                    "$ref": "#/components/examples/expired_access_token"
                  },
                  "invalid_access_token": {
                    "$ref": "#/components/examples/invalid_access_token"
                  },
                  "jwt_authentication_error": {
                    "$ref": "#/components/examples/jwt_authentication_error"
                  },
                  "method_unauthorized": {
                    "$ref": "#/components/examples/method_unauthorized"
                  },
                  "missing_access_token": {
                    "$ref": "#/components/examples/missing_access_token"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "post": {
        "operationId": "redeem_rewards",
        "summary": "Redeem Credits",
        "description": "Spends this person's balance on the rewards they chose, by submitting the reward bank's redeem event. The redemption is carried out after the event is accepted, so a successful call means the request was recorded - read Current Balance and Transaction History until the redemption appears in the history.",
        "x-extole-type": "CONSUMER_TO_EXTOLE",
        "tags": [
          "ACTION"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "event_name"
                ],
                "properties": {
                  "event_name": {
                    "type": "string",
                    "enum": [
                      "redeem_rewards"
                    ],
                    "description": "Always redeem_rewards. This event is what the reward bank listens for."
                  },
                  "data": {
                    "type": "object",
                    "description": "Which rewards to redeem, as the redemption center sends them."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Identifier of the redeem event. The redemption follows from it, so poll the bank rather than treating this as the redemption itself. The browser library renames this field to event_id, so a backend caller reads id."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "binding_error": {
                    "$ref": "#/components/examples/binding_error"
                  },
                  "invalid_json": {
                    "$ref": "#/components/examples/invalid_json"
                  },
                  "invalid_parameter": {
                    "$ref": "#/components/examples/invalid_parameter"
                  },
                  "missing_request_body": {
                    "$ref": "#/components/examples/missing_request_body"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "access_denied": {
                    "$ref": "#/components/examples/access_denied"
                  },
                  "expired_access_token": {
                    "$ref": "#/components/examples/expired_access_token"
                  },
                  "invalid_access_token": {
                    "$ref": "#/components/examples/invalid_access_token"
                  },
                  "jwt_authentication_error": {
                    "$ref": "#/components/examples/jwt_authentication_error"
                  },
                  "method_unauthorized": {
                    "$ref": "#/components/examples/method_unauthorized"
                  },
                  "missing_access_token": {
                    "$ref": "#/components/examples/missing_access_token"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "HEADER": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "A consumer access token, issued to a single person in the browser or app. Not a client access token - never send a client token from a consumer device.",
        "x-bearer-format": "bearer"
      },
      "QUERY_PARAM": {
        "type": "apiKey",
        "in": "query",
        "name": "access_token",
        "description": "A consumer access token, issued to a single person in the browser or app. Not a client access token - never send a client token from a consumer device."
      },
      "COOKIE": {
        "type": "apiKey",
        "in": "cookie",
        "name": "extole_token",
        "description": "A consumer access token, issued to a single person in the browser or app. Not a client access token - never send a client token from a consumer device."
      }
    },
    "schemas": {
      "RestExceptionResponse": {
        "type": "object",
        "description": "Represents the API error response",
        "properties": {
          "code": {
            "type": "string",
            "description": "Specific error code for this error type, documented per endpoint"
          },
          "http_status_code": {
            "type": "integer",
            "description": "HTTP status code that was returned with this error, useful if client get response code"
          },
          "message": {
            "type": "string",
            "description": "User readable English description of the error"
          },
          "parameters": {
            "type": "object",
            "description": "Attributes related to the error, varies be error code, documented per endpoint",
            "additionalProperties": {
              "type": "object",
              "description": "Attributes related to the error, varies be error code, documented per endpoint"
            }
          },
          "unique_id": {
            "type": "string",
            "description": "Unique id associated with this error, useful for discussions with Extole"
          }
        },
        "required": [
          "code",
          "http_status_code",
          "message",
          "parameters",
          "unique_id"
        ]
      }
    },
    "examples": {
      "binding_error": {
        "summary": "binding_error",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 400,
          "code": "binding_error",
          "message": "Argument is not of the expected type",
          "parameters": {}
        }
      },
      "invalid_json": {
        "summary": "invalid_json",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 400,
          "code": "invalid_json",
          "message": "JSON is invalid",
          "parameters": {}
        }
      },
      "invalid_parameter": {
        "summary": "invalid_parameter",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 400,
          "code": "invalid_parameter",
          "message": "Parameter is invalid.",
          "parameters": {}
        }
      },
      "missing_request_body": {
        "summary": "missing_request_body",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 400,
          "code": "missing_request_body",
          "message": "Missing request body",
          "parameters": {}
        }
      },
      "access_denied": {
        "summary": "access_denied",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 403,
          "code": "access_denied",
          "message": "The access_token provided is not permitted to access the specified resource.",
          "parameters": {}
        }
      },
      "method_unauthorized": {
        "summary": "method_unauthorized",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 403,
          "code": "method_unauthorized",
          "message": "Access forbidden to this endpoint",
          "parameters": {}
        }
      },
      "missing_access_token": {
        "summary": "missing_access_token",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 403,
          "code": "missing_access_token",
          "message": "No access_token was provided with this request.",
          "parameters": {}
        }
      },
      "expired_access_token": {
        "summary": "expired_access_token",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 403,
          "code": "expired_access_token",
          "message": "The access_token provided with this request has expired.",
          "parameters": {}
        }
      },
      "invalid_access_token": {
        "summary": "invalid_access_token",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 403,
          "code": "invalid_access_token",
          "message": "The access_token provided with this request is invalid.",
          "parameters": {}
        }
      },
      "jwt_authentication_error": {
        "summary": "jwt_authentication_error",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 403,
          "code": "jwt_authentication_error",
          "message": "The jwt authentication failed.",
          "parameters": {}
        }
      }
    }
  }
}
