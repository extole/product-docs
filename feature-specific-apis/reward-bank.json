{
  "openapi": "3.1.0",
  "info": {
    "title": "Reward Bank",
    "version": "1.0.0",
    "description": "Operations published by Extole Reward Bank components. Generated from the component contracts on my.extole.com."
  },
  "servers": [
    {
      "description": "Production - your program domain",
      "url": "https://{brand}.extole.io",
      "variables": {
        "brand": {
          "default": "yourcompany",
          "description": "Your Extole client subdomain (e.g. 'mycompany' for mycompany.extole.io)"
        }
      }
    }
  ],
  "paths": {
    "/api/v6/zones/bankable_rewards": {
      "post": {
        "summary": "Current Balance and Transaction History",
        "description": "Returns what this person can redeem and what they have redeemed already: the rewards their balance currently reaches, the suppliers those can be redeemed with, the redemption history, and the parameters the bank is configured with. Rendered for the person the access token identifies, so a person only ever sees their own bank.",
        "x-extole-type": "CONSUMER_TO_EXTOLE",
        "tags": [
          "VIEW"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetBankableRewardsRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/GetBankableRewardsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "eligible_rewards": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "data": {
                                "type": "object",
                                "description": "The reward's own data entries."
                              },
                              "name": {
                                "type": "string",
                                "description": "Name of the reward."
                              },
                              "state": {
                                "type": "string",
                                "description": "Where the reward has reached. Only SENT and FULFILLED rewards are eligible to redeem."
                              },
                              "reward_id": {
                                "type": "string",
                                "description": "Identifier of the reward. This is what a redemption sends back in rewards."
                              },
                              "face_value": {
                                "type": "string",
                                "description": "Value of the reward, in the units face_value_type names."
                              },
                              "campaign_id": {
                                "type": "string",
                                "description": "Campaign that issued it."
                              },
                              "earned_date": {
                                "type": "string",
                                "description": "When the person earned it."
                              },
                              "expiry_date": {
                                "type": "string",
                                "description": "When it stops being redeemable."
                              },
                              "program_label": {
                                "type": "string",
                                "description": "Program the reward belongs to."
                              },
                              "face_value_type": {
                                "type": "string",
                                "description": "What that value is denominated in."
                              },
                              "partner_reward_id": {
                                "type": "string",
                                "description": "Your own identifier for the reward, when one was supplied."
                              },
                              "reward_supplier_id": {
                                "type": "string",
                                "description": "Supplier the reward came from."
                              },
                              "redeemed_reward_ids": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "For a redemption, the rewards that were spent to make it."
                              }
                            },
                            "description": "A reward the person holds."
                          },
                          "description": "Rewards this person's balance currently reaches, each redeemable on its own."
                        },
                        "reward_parameters": {
                          "type": "object",
                          "properties": {
                            "max_amount": {
                              "type": "number",
                              "description": "The largest total a redemption may be for."
                            },
                            "min_amount": {
                              "type": "number",
                              "description": "The smallest total a redemption may be for."
                            },
                            "face_value_type": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              },
                              "description": "The value types this bank accepts, one per supplier it draws from."
                            },
                            "ratio_of_value_to_dollars": {
                              "type": "number",
                              "description": "What one unit of face value is worth, for showing a total."
                            }
                          },
                          "description": "How this bank is configured."
                        },
                        "redemption_history": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "data": {
                                "type": "object",
                                "description": "The reward's own data entries."
                              },
                              "name": {
                                "type": "string",
                                "description": "Name of the reward."
                              },
                              "state": {
                                "type": "string",
                                "description": "Where the redemption reward has reached."
                              },
                              "reward_id": {
                                "type": "string",
                                "description": "Identifier of the redemption reward itself. Do not send it back in rewards: redeemed_reward_ids names the eligible rewards it spent."
                              },
                              "face_value": {
                                "type": "string",
                                "description": "Value of the reward, in the units face_value_type names."
                              },
                              "campaign_id": {
                                "type": "string",
                                "description": "Campaign that issued it."
                              },
                              "earned_date": {
                                "type": "string",
                                "description": "When the person earned it."
                              },
                              "expiry_date": {
                                "type": "string",
                                "description": "When it stops being redeemable."
                              },
                              "program_label": {
                                "type": "string",
                                "description": "Program the reward belongs to."
                              },
                              "face_value_type": {
                                "type": "string",
                                "description": "What that value is denominated in."
                              },
                              "partner_reward_id": {
                                "type": "string",
                                "description": "Your own identifier for the reward, when one was supplied."
                              },
                              "reward_supplier_id": {
                                "type": "string",
                                "description": "Supplier the reward came from."
                              },
                              "redeemed_reward_ids": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "For a redemption, the rewards that were spent to make it."
                              }
                            },
                            "description": "A redemption the person has made. redeemed_reward_ids names the rewards it spent."
                          },
                          "description": "Redemptions this person has already made, in the same shape as a held reward. Poll this after redeeming: a new entry appearing is how the redemption center knows one landed."
                        },
                        "redemption_suppliers": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string",
                                "description": "Name of the supplier, as the person sees it."
                              },
                              "type": {
                                "type": "string",
                                "description": "Kind of supplier."
                              },
                              "face_value_type": {
                                "type": "string",
                                "description": "What this supplier's rewards are denominated in."
                              },
                              "reward_supplier_id": {
                                "type": "string",
                                "description": "Identifier to send as reward_supplier_id when redeeming."
                              }
                            }
                          },
                          "description": "What the balance can be redeemed for. One of these ids is what a redemption names."
                        }
                      },
                      "description": "The person's reward bank as the redemption center reads it."
                    }
                  },
                  "description": "A zone render, so the bank is inside the zone's data envelope rather than at the root."
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "binding_error": {
                    "$ref": "#/components/examples/binding_error"
                  },
                  "invalid_json": {
                    "$ref": "#/components/examples/invalid_json"
                  },
                  "invalid_parameter": {
                    "$ref": "#/components/examples/invalid_parameter"
                  },
                  "missing_request_body": {
                    "$ref": "#/components/examples/missing_request_body"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "access_denied": {
                    "$ref": "#/components/examples/access_denied"
                  },
                  "expired_access_token": {
                    "$ref": "#/components/examples/expired_access_token"
                  },
                  "invalid_access_token": {
                    "$ref": "#/components/examples/invalid_access_token"
                  },
                  "jwt_authentication_error": {
                    "$ref": "#/components/examples/jwt_authentication_error"
                  },
                  "method_unauthorized": {
                    "$ref": "#/components/examples/method_unauthorized"
                  },
                  "missing_access_token": {
                    "$ref": "#/components/examples/missing_access_token"
                  }
                }
              }
            }
          }
        },
        "servers": [
          {
            "description": "Production - your program domain",
            "url": "https://{brand}.extole.io",
            "variables": {
              "brand": {
                "default": "yourcompany",
                "description": "Your Extole client subdomain (e.g. 'mycompany' for mycompany.extole.io)"
              }
            }
          }
        ],
        "security": [
          {
            "CONSUMER_AUTH_HEADER": []
          },
          {
            "CONSUMER_AUTH_QUERY_PARAM": []
          },
          {
            "CONSUMER_AUTH_COOKIE": []
          }
        ],
        "x-extole-component": "reward-bank"
      }
    },
    "/events": {
      "post": {
        "summary": "Redeem Credits",
        "description": "Spends chosen rewards from this person's balance with one supplier, by submitting the reward bank's redeem event. The event is only accepted here - the redemption happens afterwards, and its outcome arrives as a signal rather than in this response. Read Current Balance and Transaction History until the redemption appears in redemption_history.",
        "x-extole-type": "CONSUMER_TO_EXTOLE",
        "tags": [
          "ACTION"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedeemRewardsRequest"
              }
            },
            "text/plain": {
              "schema": {
                "$ref": "#/components/schemas/RedeemRewardsRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/RedeemRewardsRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/RedeemRewardsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Identifier of the redeem event. The outcome is published as a signal named success or error against reward-<id>, and an error signal carries the reason in its data.message. The browser library renames this field to event_id, so a caller reading the raw response reads id."
                    }
                  },
                  "description": "Acceptance of the event, not the result of the redemption. A redemption that cannot go through - too little balance, a reward no longer redeemable - still answers here and fails afterwards."
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "binding_error": {
                    "$ref": "#/components/examples/binding_error"
                  },
                  "invalid_json": {
                    "$ref": "#/components/examples/invalid_json"
                  },
                  "invalid_parameter": {
                    "$ref": "#/components/examples/invalid_parameter"
                  },
                  "missing_request_body": {
                    "$ref": "#/components/examples/missing_request_body"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "access_denied": {
                    "$ref": "#/components/examples/access_denied"
                  },
                  "expired_access_token": {
                    "$ref": "#/components/examples/expired_access_token"
                  },
                  "invalid_access_token": {
                    "$ref": "#/components/examples/invalid_access_token"
                  },
                  "jwt_authentication_error": {
                    "$ref": "#/components/examples/jwt_authentication_error"
                  },
                  "method_unauthorized": {
                    "$ref": "#/components/examples/method_unauthorized"
                  },
                  "missing_access_token": {
                    "$ref": "#/components/examples/missing_access_token"
                  }
                }
              }
            }
          }
        },
        "servers": [
          {
            "description": "Production - your program domain",
            "url": "https://{brand}.extole.io",
            "variables": {
              "brand": {
                "default": "yourcompany",
                "description": "Your Extole client subdomain (e.g. 'mycompany' for mycompany.extole.io)"
              }
            }
          }
        ],
        "security": [
          {
            "CONSUMER_AUTH_HEADER": []
          },
          {
            "CONSUMER_AUTH_QUERY_PARAM": []
          },
          {
            "CONSUMER_AUTH_COOKIE": []
          }
        ],
        "x-extole-component": "reward-bank"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "CONSUMER_AUTH_HEADER": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "A consumer access token, issued to a single person in the browser or app. Not a client access token - never send a client token from a consumer device.",
        "x-bearer-format": "bearer"
      },
      "CONSUMER_AUTH_QUERY_PARAM": {
        "type": "apiKey",
        "in": "query",
        "name": "access_token",
        "description": "A consumer access token, issued to a single person in the browser or app. Not a client access token - never send a client token from a consumer device."
      },
      "CONSUMER_AUTH_COOKIE": {
        "type": "apiKey",
        "in": "cookie",
        "name": "extole_token",
        "description": "A consumer access token, issued to a single person in the browser or app. Not a client access token - never send a client token from a consumer device."
      }
    },
    "schemas": {
      "RestExceptionResponse": {
        "type": "object",
        "description": "Represents the API error response",
        "properties": {
          "code": {
            "type": "string",
            "description": "Specific error code for this error type, documented per endpoint"
          },
          "http_status_code": {
            "type": "integer",
            "description": "HTTP status code that was returned with this error, useful if client get response code"
          },
          "message": {
            "type": "string",
            "description": "User readable English description of the error"
          },
          "parameters": {
            "type": "object",
            "description": "Attributes related to the error, varies be error code, documented per endpoint",
            "additionalProperties": {
              "type": "object",
              "description": "Attributes related to the error, varies be error code, documented per endpoint"
            }
          },
          "unique_id": {
            "type": "string",
            "description": "Unique id associated with this error, useful for discussions with Extole"
          }
        },
        "required": [
          "code",
          "http_status_code",
          "message",
          "parameters",
          "unique_id"
        ]
      },
      "GetBankableRewardsRequest": {
        "type": "object",
        "description": "Optional data merged into the zone's rendering context. Send an empty object when there is nothing to add."
      },
      "RedeemRewardsRequest": {
        "type": "object",
        "required": [
          "event_name",
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "rewards",
              "reward_supplier_id"
            ],
            "properties": {
              "labels": {
                "type": "string",
                "description": "The program label the redemption belongs to."
              },
              "rewards": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The reward_id of each reward being spent, taken from eligible_rewards."
              },
              "reward_supplier_id": {
                "type": "string",
                "description": "The supplier to redeem with, taken from redemption_suppliers."
              }
            },
            "description": "What to redeem and what to redeem it for."
          },
          "event_name": {
            "enum": [
              "redeem_rewards"
            ],
            "type": "string",
            "description": "Always redeem_rewards. This event is what the reward bank listens for."
          }
        }
      }
    },
    "examples": {
      "binding_error": {
        "summary": "binding_error",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 400,
          "code": "binding_error",
          "message": "Argument is not of the expected type",
          "parameters": {}
        }
      },
      "invalid_json": {
        "summary": "invalid_json",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 400,
          "code": "invalid_json",
          "message": "JSON is invalid",
          "parameters": {}
        }
      },
      "invalid_parameter": {
        "summary": "invalid_parameter",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 400,
          "code": "invalid_parameter",
          "message": "Parameter is invalid.",
          "parameters": {}
        }
      },
      "missing_request_body": {
        "summary": "missing_request_body",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 400,
          "code": "missing_request_body",
          "message": "Missing request body",
          "parameters": {}
        }
      },
      "access_denied": {
        "summary": "access_denied",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 403,
          "code": "access_denied",
          "message": "The access_token provided is not permitted to access the specified resource.",
          "parameters": {}
        }
      },
      "expired_access_token": {
        "summary": "expired_access_token",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 403,
          "code": "expired_access_token",
          "message": "The access_token provided with this request has expired.",
          "parameters": {}
        }
      },
      "invalid_access_token": {
        "summary": "invalid_access_token",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 403,
          "code": "invalid_access_token",
          "message": "The access_token provided with this request is invalid.",
          "parameters": {}
        }
      },
      "jwt_authentication_error": {
        "summary": "jwt_authentication_error",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 403,
          "code": "jwt_authentication_error",
          "message": "The jwt authentication failed.",
          "parameters": {}
        }
      },
      "method_unauthorized": {
        "summary": "method_unauthorized",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 403,
          "code": "method_unauthorized",
          "message": "Access forbidden to this endpoint",
          "parameters": {}
        }
      },
      "missing_access_token": {
        "summary": "missing_access_token",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 403,
          "code": "missing_access_token",
          "message": "No access_token was provided with this request.",
          "parameters": {}
        }
      }
    }
  }
}
