{
  "openapi": "3.1.0",
  "info": {
    "title": "Reward Bank",
    "version": "1.0.0",
    "description": "Tracks a redeemable points balance per person, and the transactions that move it.\n\n**Demo contract for the ENG-30863 docs preview. Operations are illustrative and are not implemented; do not integrate against this page.**"
  },
  "servers": [
    {
      "description": "Production",
      "url": "https://api.extole.io"
    }
  ],
  "paths": {
    "/v5/persons/{person_id}/reward-bank": {
      "get": {
        "operationId": "get_reward_balance",
        "summary": "Get Reward Balance",
        "description": "Returns the person's current Reward Bank balance and the reward unit it is denominated in.",
        "x-extole-type": "SERVER_TO_EXTOLE",
        "tags": [
          "Views"
        ],
        "parameters": [
          {
            "name": "person_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "required": [
                    "person_id",
                    "balance",
                    "reward_unit"
                  ],
                  "properties": {
                    "balance": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Currently redeemable balance."
                    },
                    "person_id": {
                      "type": "string",
                      "description": "Extole person id the balance belongs to."
                    },
                    "updated_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "reward_unit": {
                      "type": "string",
                      "description": "Unit the balance is denominated in, e.g. POINTS."
                    },
                    "pending_balance": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Earned but not yet redeemable."
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "binding_error": {
                    "$ref": "#/components/examples/binding_error"
                  },
                  "invalid_json": {
                    "$ref": "#/components/examples/invalid_json"
                  },
                  "invalid_parameter": {
                    "$ref": "#/components/examples/invalid_parameter"
                  },
                  "missing_request_body": {
                    "$ref": "#/components/examples/missing_request_body"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "access_denied": {
                    "$ref": "#/components/examples/access_denied"
                  },
                  "method_unauthorized": {
                    "$ref": "#/components/examples/method_unauthorized"
                  },
                  "missing_access_token": {
                    "$ref": "#/components/examples/missing_access_token"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v5/persons/{person_id}/reward-bank/transactions": {
      "get": {
        "operationId": "get_transaction_history",
        "summary": "Get Transaction History",
        "description": "Returns the person's Reward Bank transactions, most recent first.",
        "x-extole-type": "SERVER_TO_EXTOLE",
        "tags": [
          "Views"
        ],
        "parameters": [
          {
            "name": "person_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "required": [
                    "transactions"
                  ],
                  "properties": {
                    "next_offset": {
                      "type": "string",
                      "description": "Opaque cursor; absent on the last page."
                    },
                    "transactions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "transaction_id",
                          "type",
                          "amount",
                          "created_at"
                        ],
                        "properties": {
                          "type": {
                            "enum": [
                              "EARN",
                              "REDEEM",
                              "EXPIRE",
                              "ADJUST"
                            ],
                            "type": "string"
                          },
                          "amount": {
                            "type": "integer",
                            "description": "Signed change to the balance."
                          },
                          "reason": {
                            "type": "string"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "balance_after": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "transaction_id": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "binding_error": {
                    "$ref": "#/components/examples/binding_error"
                  },
                  "invalid_json": {
                    "$ref": "#/components/examples/invalid_json"
                  },
                  "invalid_parameter": {
                    "$ref": "#/components/examples/invalid_parameter"
                  },
                  "missing_request_body": {
                    "$ref": "#/components/examples/missing_request_body"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "access_denied": {
                    "$ref": "#/components/examples/access_denied"
                  },
                  "method_unauthorized": {
                    "$ref": "#/components/examples/method_unauthorized"
                  },
                  "missing_access_token": {
                    "$ref": "#/components/examples/missing_access_token"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v5/persons/{person_id}/reward-bank/redemptions": {
      "post": {
        "operationId": "redeem_credits",
        "summary": "Redeem Credits",
        "description": "Debits the person's Reward Bank balance and issues a redemption. Idempotent on request_id.",
        "x-extole-type": "SERVER_TO_EXTOLE",
        "tags": [
          "Actions"
        ],
        "parameters": [
          {
            "name": "person_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "required": [
                  "amount",
                  "request_id"
                ],
                "properties": {
                  "note": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "amount": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Number of reward units to redeem."
                  },
                  "request_id": {
                    "type": "string",
                    "description": "Caller-supplied idempotency key; a repeat returns the original redemption."
                  },
                  "reward_supplier_id": {
                    "type": "string",
                    "description": "Overrides the component's configured supplier."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "required": [
                    "redemption_id",
                    "status",
                    "amount",
                    "balance_after"
                  ],
                  "properties": {
                    "amount": {
                      "type": "integer"
                    },
                    "status": {
                      "enum": [
                        "FULFILLED",
                        "PENDING",
                        "FAILED"
                      ],
                      "type": "string"
                    },
                    "reward_id": {
                      "type": "string",
                      "description": "Reward issued by the supplier, when status is FULFILLED."
                    },
                    "balance_after": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "redemption_id": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "binding_error": {
                    "$ref": "#/components/examples/binding_error"
                  },
                  "invalid_json": {
                    "$ref": "#/components/examples/invalid_json"
                  },
                  "invalid_parameter": {
                    "$ref": "#/components/examples/invalid_parameter"
                  },
                  "missing_request_body": {
                    "$ref": "#/components/examples/missing_request_body"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "access_denied": {
                    "$ref": "#/components/examples/access_denied"
                  },
                  "method_unauthorized": {
                    "$ref": "#/components/examples/method_unauthorized"
                  },
                  "missing_access_token": {
                    "$ref": "#/components/examples/missing_access_token"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v5/me/reward-bank": {
      "get": {
        "operationId": "get_my_reward_balance",
        "summary": "Get My Reward Balance",
        "description": "Returns the calling consumer's own Reward Bank balance, resolved from the access token.",
        "x-extole-type": "CONSUMER_TO_EXTOLE",
        "tags": [
          "Views"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "required": [
                    "balance",
                    "reward_unit"
                  ],
                  "properties": {
                    "balance": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "reward_unit": {
                      "type": "string"
                    },
                    "pending_balance": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "binding_error": {
                    "$ref": "#/components/examples/binding_error"
                  },
                  "invalid_json": {
                    "$ref": "#/components/examples/invalid_json"
                  },
                  "invalid_parameter": {
                    "$ref": "#/components/examples/invalid_parameter"
                  },
                  "missing_request_body": {
                    "$ref": "#/components/examples/missing_request_body"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "access_denied": {
                    "$ref": "#/components/examples/access_denied"
                  },
                  "expired_access_token": {
                    "$ref": "#/components/examples/expired_access_token"
                  },
                  "invalid_access_token": {
                    "$ref": "#/components/examples/invalid_access_token"
                  },
                  "jwt_authentication_error": {
                    "$ref": "#/components/examples/jwt_authentication_error"
                  },
                  "method_unauthorized": {
                    "$ref": "#/components/examples/method_unauthorized"
                  },
                  "missing_access_token": {
                    "$ref": "#/components/examples/missing_access_token"
                  }
                }
              }
            }
          }
        },
        "servers": [
          {
            "description": "Your program domain",
            "url": "https://{program_domain}",
            "variables": {
              "program_domain": {
                "default": "refer.example.com",
                "description": "The program domain of the Extole program you are calling."
              }
            }
          }
        ],
        "security": [
          {
            "HEADER": []
          },
          {
            "QUERY": []
          },
          {
            "COOKIE": []
          }
        ]
      }
    },
    "/v6/events": {
      "post": {
        "operationId": "submit_earn_event",
        "summary": "Submit Earn Event",
        "description": "Records an event that credits the person's Reward Bank balance.",
        "x-extole-type": "SERVER_TO_EXTOLE",
        "tags": [
          "Actions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "event_name": {
                    "type": "string",
                    "const": "reward_bank_earn"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "amount": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Reward units to credit."
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "event_name",
                  "email",
                  "amount"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "event_id": {
                      "type": "string"
                    },
                    "processed": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "event_id"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "binding_error": {
                    "$ref": "#/components/examples/binding_error"
                  },
                  "invalid_json": {
                    "$ref": "#/components/examples/invalid_json"
                  },
                  "invalid_parameter": {
                    "$ref": "#/components/examples/invalid_parameter"
                  },
                  "missing_request_body": {
                    "$ref": "#/components/examples/missing_request_body"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "access_denied": {
                    "$ref": "#/components/examples/access_denied"
                  },
                  "method_unauthorized": {
                    "$ref": "#/components/examples/method_unauthorized"
                  },
                  "missing_access_token": {
                    "$ref": "#/components/examples/missing_access_token"
                  }
                }
              }
            }
          }
        },
        "servers": [
          {
            "description": "Production",
            "url": "https://events.extole.io"
          }
        ]
      }
    }
  },
  "components": {
