{
  "openapi": "3.1.0",
  "info": {
    "title": "Business Event",
    "version": "1.0.0",
    "description": "Records a tracked customer action that programs can trigger and reward on.\n\n**Demo contract for the ENG-30863 docs preview. Operations are illustrative and are not implemented; do not integrate against this page.**"
  },
  "servers": [
    {
      "description": "Production",
      "url": "https://api.extole.io"
    }
  ],
  "paths": {
    "/v6/events": {
      "post": {
        "operationId": "increment_counter",
        "summary": "Increment Counter",
        "description": "Records an occurrence of this business event for a person, advancing its counter.",
        "x-extole-type": "SERVER_TO_EXTOLE",
        "tags": [
          "business-event",
          "EVENT"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "required": [
                  "event_name",
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "event_name": {
                    "type": "string",
                    "description": "Name of the business event to increment."
                  },
                  "increment_by": {
                    "type": "integer",
                    "default": 1,
                    "minimum": 1
                  },
                  "partner_event_id": {
                    "type": "string",
                    "description": "Caller's own id for this occurrence; deduplicates retries."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "required": [
                    "event_id"
                  ],
                  "properties": {
                    "counter": {
                      "type": "integer"
                    },
                    "event_id": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "binding_error": {
                    "$ref": "#/components/examples/binding_error"
                  },
                  "invalid_json": {
                    "$ref": "#/components/examples/invalid_json"
                  },
                  "invalid_parameter": {
                    "$ref": "#/components/examples/invalid_parameter"
                  },
                  "missing_request_body": {
                    "$ref": "#/components/examples/missing_request_body"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "access_denied": {
                    "$ref": "#/components/examples/access_denied"
                  },
                  "method_unauthorized": {
                    "$ref": "#/components/examples/method_unauthorized"
                  },
                  "missing_access_token": {
                    "$ref": "#/components/examples/missing_access_token"
                  }
                }
              }
            }
          }
        },
        "servers": [
          {
            "description": "Production",
            "url": "https://events.extole.io"
          }
        ]
      }
    },
    "/v5/business-events": {
      "post": {
        "operationId": "create_new",
        "summary": "Create New Business Event",
        "description": "Defines a new business event on this component so it can be triggered and rewarded.",
        "x-extole-type": "SERVER_TO_EXTOLE",
        "tags": [
          "ACTION",
          "business-event"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "display_name": {
                    "type": "string"
                  },
                  "journey": {
                    "type": "string",
                    "description": "Journey the event belongs to."
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "business_event_id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "business_event_id",
                    "name"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "binding_error": {
                    "$ref": "#/components/examples/binding_error"
                  },
                  "invalid_json": {
                    "$ref": "#/components/examples/invalid_json"
                  },
                  "invalid_parameter": {
                    "$ref": "#/components/examples/invalid_parameter"
                  },
                  "missing_request_body": {
                    "$ref": "#/components/examples/missing_request_body"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestExceptionResponse"
                },
                "examples": {
                  "access_denied": {
                    "$ref": "#/components/examples/access_denied"
                  },
                  "method_unauthorized": {
                    "$ref": "#/components/examples/method_unauthorized"
                  },
                  "missing_access_token": {
                    "$ref": "#/components/examples/missing_access_token"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RestExceptionResponse": {
        "type": "object",
        "description": "Represents the API error response",
        "properties": {
          "code": {
            "type": "string",
            "description": "Specific error code for this error type, documented per endpoint"
          },
          "http_status_code": {
            "type": "integer",
            "description": "HTTP status code that was returned with this error, useful if client get response code"
          },
          "message": {
            "type": "string",
            "description": "User readable English description of the error"
          },
          "parameters": {
            "type": "object",
            "description": "Attributes related to the error, varies be error code, documented per endpoint",
            "additionalProperties": {
              "type": "object",
              "description": "Attributes related to the error, varies be error code, documented per endpoint"
            }
          },
          "unique_id": {
            "type": "string",
            "description": "Unique id associated with this error, useful for discussions with Extole"
          }
        },
        "required": [
          "code",
          "http_status_code",
          "message",
          "parameters",
          "unique_id"
        ]
      }
    },
    "examples": {
      "binding_error": {
        "summary": "binding_error",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
          "http_status_code": 400,
          "code": "binding_error",
          "message": "Argument is not of the expected type",
          "parameters": {}
        }
      },
      "invalid_json": {
        "summary": "invalid_json",
        "value": {
          "unique_id": "00000000-0000-0000-0000-000000000000",
